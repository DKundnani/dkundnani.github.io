<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>bio.dkundnani.metrics</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/deepalikundnani/Documents/git/dkundnani.github.io/scripts/refresh-metrics-local.sh</string>
    </array>

    <!-- 1st of every month, 10:00 local time. If the Mac is asleep or off,
         launchd runs it at the next opportunity. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>     <integer>1</integer>
        <key>Hour</key>    <integer>10</integer>
        <key>Minute</key>  <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/deepalikundnani/Documents/git/dkundnani.github.io</string>

    <key>StandardOutPath</key>
    <string>/Users/deepalikundnani/Library/Logs/dkundnani-metrics.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/deepalikundnani/Library/Logs/dkundnani-metrics.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
